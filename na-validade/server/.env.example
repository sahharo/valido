DATABASE_URL=postgres://navalidade:navalidade@localhost:5432/navalidade
PORT=3333
# Set to true when served over HTTPS (production) so the session cookie is only sent over TLS.
COOKIE_SECURE=false
# Identifies the app to Open Food Facts, as their API terms ask (name/version + contact).
OFF_USER_AGENT=NaValidade/1.0 (contato@navalidade.app)
# Token do Cosmos (cosmos.bluesoft.com.br). Opcional: sem ele, só as bases Open Facts são usadas.
COSMOS_TOKEN=
